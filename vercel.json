{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.howtogetajob.tech" }],
      "destination": "https://howtogetajob.tech/:path*",
      "permanent": true
    }
  ]
}
